  ],
  "decisions": {
   "sites": {
    "17B": {
     "alt_notes": {},
     "basis": "4955d8e8069698de",
     "rationale": "Channel and bank stabilization without beaver removal is the site's best buy and gives the most lift.",
     "recommended_alt_id": "Alternative2"
    },
    "17D2E": {
     "alt_notes": {},
     "basis": "c58310c780599363",
     "rationale": "Channel removal with a left bank wetland addresses the concrete channel directly, with a large lift and a low unit cost.",
     "recommended_alt_id": "Alternative1"
    },
    "17F2M": {
     "alt_notes": {},
     "basis": "91660bb2766a52e1",
     "rationale": "The chain of wetlands gives the largest lift for a cost close to the other alternatives; it is the site's only best buy besides No Action.",
     "recommended_alt_id": "Alternative3"
    },
    "19A": {
     "alt_notes": {},
     "basis": "339c9559e8d34976",
     "rationale": "The largest best buy, with high lift for South Utoy Creek.",
     "recommended_alt_id": "Alternative2"
    },
    "2A": {
     "alt_notes": {},
     "basis": "343c89f1d97ead7a",
     "rationale": "The largest best buy: the most lift in the watershed at the lowest unit cost.",
     "recommended_alt_id": "Alternative1"
    },
    "2B": {
     "alt_notes": {},
     "basis": "56c84b760d9562e5",
     "rationale": "The largest best buy, with a low unit cost like Site 2A.",
     "recommended_alt_id": "Alternative1"
    },
    "3E": {
     "alt_notes": {},
     "basis": "67049bb4fd32f97e",
     "rationale": "The unit costs of both best buys are far above every other site, so no action is recommended at this site.",
     "recommended_alt_id": "FWOP"
    },
    "3F": {
     "alt_notes": {},
     "basis": "8f486c20294e542f",
     "rationale": "The largest best buy, and a place to demonstrate innovative low-cost methods.",
     "recommended_alt_id": "Alternative1"
    }
   },
   "watershed": {
    "basis": "e83b6bac9338d45f",
    "final_array": {
     "17B=Alternative2;17D2E=Alternative1;19A=Alternative2;2A=Alternative1;2B=Alternative1;3F=Alternative1": {
      "included": false,
      "note": "Removed because P16 already introduces Site 3F."
     },
     "19A=Alternative2;2A=Alternative1;2B=Alternative1;3F=Alternative1": {
      "included": true,
      "note": "Cost-effective plan added: near parity between North and South Utoy, and it introduces the innovative actions at 3F."
     },
     "2A=Alternative1": {
      "included": false,
      "note": "Only one sub-watershed; the study's scope emphasized actions across the whole watershed."
     },
     "2A=Alternative1;2B=Alternative1": {
      "included": false,
      "note": "Only North Utoy Creek; the first plan with actions in both sub-watersheds is P14."
     }
    },
    "steps": {
     " > 19A=Alternative2;2A=Alternative1;2B=Alternative1": {
      "why": "The smallest acceptable plan: the first with actions in both the North and South Utoy sub-watersheds.",
      "worth_it": "YES"
     },
     "17B=Alternative2;17D2E=Alternative1;19A=Alternative2;2A=Alternative1;2B=Alternative1 > 17B=Alternative2;17D2E=Alternative1;17F2M=Alternative3;19A=Alternative2;2A=Alternative1;2B=Alternative1;3F=Alternative1": {
      "why": "Site 17F2M addresses the largest extent of concrete channel; working with 17D2E should cut mobilization costs, and the plan has the widest coverage.",
      "worth_it": "YES"
     },
     "17B=Alternative2;19A=Alternative2;2A=Alternative1;2B=Alternative1 > 17B=Alternative2;17D2E=Alternative1;19A=Alternative2;2A=Alternative1;2B=Alternative1": {
      "why": "Site 17D2E begins to address the concrete channel, a major cause of degradation.",
      "worth_it": "YES"
     },
     "19A=Alternative2;2A=Alternative1;2B=Alternative1 > 19A=Alternative2;2A=Alternative1;2B=Alternative1;3F=Alternative1": {
      "why": "Site 3F adds high benefit at low cost and demonstrates innovative methods for the region.",
      "worth_it": "YES"
     },
     "19A=Alternative2;2A=Alternative1;2B=Alternative1;3F=Alternative1 > 17B=Alternative2;19A=Alternative2;2A=Alternative1;2B=Alternative1": {
      "why": "Site 17B extends actions upstream and cuts sediment delivered to Sites 2A and 2B.",
      "worth_it": "YES"
     }
    },
    "tsp": "17B=Alternative2;17D2E=Alternative1;17F2M=Alternative3;19A=Alternative2;2A=Alternative1;2B=Alternative1;3F=Alternative1",
    "tsp_plan_type": "National Ecosystem Restoration (NER) plan",
    "tsp_rationale": "All seven sites: the widest geographic coverage, and it directly addresses the concrete channel that drives degradation in the watershed. Sites can still be dropped after further analysis such as real estate."
   }
  },
  "description": "Aquatic ecosystem restoration in the Utoy Creek watershed, Atlanta, Georgia (Continuing Authorities Program Section 206). Eight candidate sites along North and South Utoy Creek; ecological outputs from the Riparian Ecological Functions Index and the Utoy Instream Model; the FY2025 federal discount rate (3 percent).",
